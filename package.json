{
  "name": "resume",
  "title": "Éric NICOLAS - Resume",
  "version": "2.1.0",
  "packageManager": "pnpm@10.4.0",
  "description": "My static HTML resume, printed out into an A4 portrait PDF document",
  "author": "Éric NICOLAS (ccjmne) <ccjmne@gmail.com>",
  "license": "GPL-3.0",
  "homepage": "https://github.com/ccjmne/resume#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:ccjmne/resume.git"
  },
  "bugs": {
    "url": "https://github.com/ccjmne/resume/issues"
  },
  "keywords": ["ccjmne", "html", "pdf", "resume"],
  "scripts": {
    "start": "HYPHENATE=yes PORT=8042 vite       --log-level info",
    "build": "BROWSER_KEEPALIVE=0     vite build --log-level warn",
    "ghost": "gs -sDEVICE=pdfwrite -dBATCH -dNOPAUSE -dQUIET -sOutputFile=dist/${OUT:-compressed.pdf} dist/${IN:-resume.pdf}",
    "weave": "TWOPASS=yes pnpm build && pnpm ghost && evince dist/compressed.pdf"
  },
  "dependencies": {
    "pdfjs": "^2.5.4",
    "puppeteer-core": "^25.17.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/hyphen": "^1.14.0",
    "@types/jsdom": "^30.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/which": "^3.0.4",
    "hyphen": "^1.14.1",
    "jsdom": "^31.0.0",
    "mkdirp": "^3.0.1",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "vite": "^8.3.7",
    "which": "^7.0.0"
  }
}
